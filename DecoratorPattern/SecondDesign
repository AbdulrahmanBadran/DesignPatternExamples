    }
}



public class Program
{
    public static void Main()
    {
        DarkRoast coffee = new DarkRoast();

        coffee.SetMilk(true);
        coffee.SetMocha(true);

        Console.WriteLine(coffee.GetDescription());
        Console.WriteLine(coffee.Cost());
    }
}
